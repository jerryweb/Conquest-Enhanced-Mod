msgctxt "mission/multi/artillery_destroyed_1"
msgid "Arty Noob"
msgstr "Manco, campero"

msgctxt "mission/multi/artillery_destroyed_2"
msgid "No don't restart now! We're just getting started!"
msgstr "No reinicies ahora! Solo estamos empezando!"

msgctxt "mission/multi/artillery_destroyed_3"
msgid "Dang how much CP did that Artillery take up?"
msgstr "Cuanto CP te costó esa pieza de artilleria?"



msgctxt "mission/multi/generic_taunt_1"
msgid "Did that hurt?"
msgstr "Ouch, dolio?"

msgctxt "mission/multi/generic_taunt_2"
msgid "You're such a Nub!"
msgstr "Menudo novato"

msgctxt "mission/multi/generic_taunt_3"
msgid "Go back to playing Vanilla Conquest pussy boy!"
msgstr "Vete de vuelta a la version vanilla, blandengue!"

msgctxt "mission/multi/generic_taunt_4"
msgid "GG EZ"
msgstr "Fácil, lol"



msgctxt "mission/multi/heavy_tank_destroyed_1"
msgid "That heavy tank is gone. Must have been expensive."
msgstr "Ese tanque pesado se esfumó, Debió de ser caro eh?"

msgctxt "mission/multi/heavy_tank_destroyed_2"
msgid "Freaking NOOB!!!!"
msgstr "Menudo manco!"

msgctxt "mission/multi/heavy_tank_destroyed_3"
msgid "Destroyed your heavy tank... Who will tell the families of those crew?"
msgstr "Petamos tu tanque pesado... Como se lo dirás a sus familias?"



msgctxt "mission/multi/officer_killed_1"
msgid "Oof! We just killed your officer............ Noob"
msgstr "Oof! hemos matado a tu oficial... manco"

msgctxt "mission/multi/officer_killed_2"
msgid "Your officer was slain. Who will lead your troops now? You?!?!"
msgstr "Tu oficial esta muerto. Quien liderará tus tropas ahora? tu??"

msgctxt "mission/multi/officer_killed_3"
msgid "HA Officer down! Better call your medic!"
msgstr "Ha! Le dimos! date prisa y llama al medico!"

msgctxt "mission/multi/officer_killed_4"
msgid "Your men don't respect you."
msgstr "Tus hombres no te respetan."



msgctxt "mission/multi/radio_car_destroyed_1"
msgid "Looks like we took out your radio vehicle. EZ"
msgstr "Ahi va tu vehiculo de radio. Facil"
