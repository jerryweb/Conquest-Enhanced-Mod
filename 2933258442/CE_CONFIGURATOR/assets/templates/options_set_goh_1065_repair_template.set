{options
	{video
		{window_mode fullscreen}
		{preset custom}
		{vertical_sync}
		{antialiasing "4x"}
		{fxaa}
		{detail detail_high}
		{shadow ultra}
		{filtering anisotropic8x}
		{model_quality high}
		{fx_quality high}
		{bumpType parallax}
		{specular}
		{environment}
		{water_quality ultra}
		{grass}
		{lens_effects_options high}
		{lens_refraction}
		{dof}
		{softIntersection}
		{_ssao high}
		{fake_translucency}
		{glow}
		{rim_light}
		{filmGrain}
		{alphaToCoverage}
		{clip_distance 1}
	}
	{sound
		{speaker_config use_system_settings}
		{rate "44_khz"}
		{buffers "64"}
		{enable_hit_sound}
		{volume
			{master 100}
			{effects 30}
			{emotions 50}
			{environment 40}
			{interface 1}
			{game_music 0}
			{narrator 100}
		}
	}
	{game
		{difficulty heroic}
		{fog_of_war fog_realistic}
		{hardcore 0}
		{manual_mode tpc_mode}
		{subtitles}
		{invert_mouse_wheel 0}
		{invert_camera_third_person 0}
		{camera_scroll_speed 0.2}
		{camera_rotate_speed 1}
		{camera_speed_third_person 0.2}
		{mouseout_camera_movement}
		{hints}
		{action_by_left_click 0}
		{threat_markers}
		{global_chat}
		{autosave}
		{mouse_navigation}
		{selection_circle
			{start_radius 64}
			{growth_per_second 256}
			{max_radius 256}
		}
	}
