	{particleview "molten_sparks"
		{generator
			{emissionarea
				{radius 1 1}
				{alpha0 0 360}
				{alpha1 0 360}
				{theta 80}
			}
			{particleinit
				{speed 6 3}          ; slower, more floaty
				{lifetime 8 3}       ; stays visible for a long time
			}
			{timetolive 6}          ; generator lives long enough to feed embers
			{totalparticles 6000}
			{particlesinblock 6000}
		}
		{mover
			{damping 0.99}          ; keeps velocity from dying too fast
			{gravity
				{value 0.03}        ; very gentle fall
			}
			{collisions
				{terrain}
				{restitution 0.2}   ; small bounce, then settle
			}
		}
