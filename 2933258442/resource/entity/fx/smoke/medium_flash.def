{fx
	{sound "hit/steel/hit/large/heat"}

	{#+ spriteview halo_fast
		{sprite "$/flash/halo03"
			{timer
				{mode }
				{duration 0.25}
			}
			{scale 6}
			{light 1
				{linear
					{min 0.8}
					{max 0}
				}
			}
			{highlight 0xfffea742}
		}
		{halo}
		{notifyowner}
		{autovisible}
	}

	{#+ lightview point
		{type point}
		{animator
			{timer
				{duration 0.8}
			}
			{visibility 1
				{linear
					{min 0.25}
					{max 0}
				}
			}
			{highlight 0xffedb0}
		}
		{attenuation0 0.02}
		{attenuation1 0.4}
		{radius 200}
		{effectonground}
		{offset 0 0 120}
	}

	{#+ spriteview halo1
		{sprite "$/flash/halo03"
			{timer
				{mode }
				{duration 0.5}
			}
			{scale 0.7}
			{light 1
				{power
					{min 0.5}
					{max 0}
					{pow 0.7}
				}
			}
			{highlight 0xfffd8041}
		}
		{halo}
		{notifyowner}
		{autovisible}
		{offset 0 0 35}
	}

	{#+ spriteview halo_fast_small
		{sprite "$/flash/halo03"
			{timer
				{mode }
				{duration 0.2}
			}
			{scale 0.5}
			{light 1
				{linear
					{min 0.4}
					{max 0}
				}
			}
			{highlight 0xfffea477}
		}
		{halo}
		{notifyowner}
		{autovisible}
	}

	{#+ spriteview halo_new
		{sprite "$/flash/halo01"
			{timer
				{mode }
				{duration 0.25}
			}
			{preturn 90 90}
			{scale 2}
			{light 1
				{linear
					{min 0.6}
					{max 0}
				}
			}
			{highlight 0xfffed5b7}
		}
		{halo}
		{notifyowner}
		{autovisible}
	}

	{#+ particleview spark
		{generator
			{emissionarea
				{radius 10 10}
				{speed 120}
				{alpha0 15 15}
				{alpha1 40 40}
			}
			{particleinit
				{speed 0.8 0.7}
				{lifetime 3 2}
			}
			{timetolive 0.2}
		}
		{mover
			{gravity
				{value 0.015}
			}
		}
		{visualizer
			{stage 
				{sprite "/texture/fx/flash/flashss3"
					{visibility 0.5 -0.5
						{peak
							{min 0.35}
							{max 0}
						}
					}
					{scale 1
						{linear
							{min 0.015 0.005}
							{max 0.035 0.005}
						}
					}
				}
			}
		}
	}

	{#+ particleview shock
		{generator
			{totalparticles 1}
			{emissionarea
				{radius 0}
			}
			{particleinit
				{speed 0}
				{lifetime 0.15}
			}
			{particlesinblock 1}
			{timetolive 0.01}
		}
		{offset 0 0 10}
		{visualizer
			{stage 
				{sprite "$/flash/flash_shockwave"
					{timer
						{mode play }
						{duration -1}
					}
					{scale 1
						{linear
							{min 0}
							{max 0.9}
						}
					}
					{visibility 1
						{peak
							{min 0.2}
							{max 0.7}
						}
					}
					{preturn 90 90}
				}
			}
		}
		{notifyowner}
	}
}