	{Resources
		
			{MP ;// Manpower (generic money)
				{StartVal 4000}
				{WinGain "1:300 4:350 6:400 8:1200 9:700 10:500 12:700 14:800"} ;// games played : MP gain 
				{LoseGain "1:200 4:300 6:700 12:900"}
				{MapRewards	;//Bonus resources on various game types (a game can only be one randomly chosen type). Types: Airfield, Ammodepot, Bonus, Factory, Research.
					{Airfield	1000}
					{Ammodepot	200}
					{Bonus		500}
					{Factory	500}
					{Research	100}
				}
			}
			{SP ;// Special Points (airstrikes)
				{StartVal 10}
				{WinGain  "1:1 6:3 8:10 16:20"}
				{LoseGain "1:1 6:3 8:10 16:20"}
				{MapRewards
					{Airfield	16}
				}
			}
			{AP ;// Ammo points
				{StartVal 3000}
				{WinGain "5:350 10:500 15:900"}
				{LoseGain "5:225 10:350 15:900"}
				{MapRewards
					{Ammodepot	1600}
					{Factory	700}
             	}
