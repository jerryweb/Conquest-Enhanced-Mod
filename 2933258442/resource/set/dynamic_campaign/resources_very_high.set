			{turret 0 % MP 37 % AP}
			{engine 0 % MP 39 % AP}
			{track 0 % MP 16 % AP}
			{shield 0 % MP 3 % AP}
			{other 0 % MP 2 % AP} ;// If none of the above. Required.
