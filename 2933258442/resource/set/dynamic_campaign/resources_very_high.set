	{Resources
		
			{MP ;// Manpower (generic money)
				{StartVal 5000}
				{WinGain "1:300 4:350 6:400 8:1100 9:650 10:750 12:850 14:950"} ;// games played : MP gain 
				{LoseGain "1:200 4:300 6:700 8:900 10:1000 12:1400 14:1700"}
				{MapRewards	;//Bonus resources on various game types (a game can only be one randomly chosen type). Types: Airfield, Ammodepot, Bonus, Factory, Research.
					{Airfield	1100}
					{Ammodepot	300}
					{Bonus		800}
					{Factory	600}
					{Research	100}
				}
			}
			{SP ;// Special Points (airstrikes)
				{StartVal 20}
				{WinGain "1:2 4:3 6:5 8:6 10:7 12:8 14:10"}
				{LoseGain "1:2 4:3 6:5 8:6 10:7 12:8 14:10" }
				{MapRewards
					{Airfield	18}
				}
			}
			{AP ;// Ammo points
				{StartVal 4000}
				{WinGain "5:350 10:700 15:1000"}
				{LoseGain "5:225 10:350 15:500"}
				{MapRewards
					{Ammodepot	2800}
					{Factory	1200}
				}
			}
			{RP ;// Research points
				{StartVal 18}
