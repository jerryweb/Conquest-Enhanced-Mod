{Low
	{GlobalMaxCP 1000}
	{StageCP 45 45 45 45 45}
	{SpecialCP 50}					;// airstrikes special tab
	{EmplacementCP 50}				;// buildable with engineer
	{Bots
		{StartMP	1.75 min 2000 attackerMultiplier 3.25}
		{FinishMP	1.75 min 2000 attackerMultiplier 3.25}
		{CP
			{Base "0:60"} ;// seconds : CP
			{RoundMultiplier "0:1.2 1:0.5 2:1.3 3:0.7 4:1.45 5:0.75 6:1.55 7:0.8 8:0.95 9:0.85 10:1.05 11:1.0 12:1.1 14:1.2 16:1.3 18:1.4 20:1.5"} ;// games played : multiplier for CP
			{AttackMultiplier 3.8}
		}
		{DefenseLevel
			{level_1
				{DefenseBudgetPlayer	0.4}	;// budget it multiplied by number of flags
				{DefenseBudgetAI		0.4}	;// places defender units with bot StartMP * this factor (StartMP without attackermultiplier) for player side
				{unlock games 0 progress 0.0}	;// number of games to unlock this level, or progress in percent (campaign progress bar)
			}
			{level_2							;// once level is reached previous level values are ignored only currently level is used
				{DefenseBudgetPlayer	0.45}
				{DefenseBudgetAI		0.55}
				{unlock games 8 progress 0.4}
			}
			{level_3
				{DefenseBudgetPlayer	0.50}
				{DefenseBudgetAI		0.75}
				{unlock games 16 progress 0.6}
			}
		}
	}
	{PaybackFactor 0.2 0 0 0}		;// MP paid back when loosing solider, squad or vehicle
	{SellFactor 0.4 0 0 0}
	{ScavengedVehicleSellFactor 0.1}		;// captured enemy vehicle 
	{RiskFactor
		{Low
			{BotResources 0.85}
			{BotVeterancy 3}
			{Rewards 1.25}
		}
		{Standard
			{BotResources 1.0}
			{BotVeterancy 4}
			{Rewards 1.5}
		}
		{High
			{BotResources 1.25}
			{BotVeterancy 6}
			{Rewards 1.75}
		}
	}
	{Resources		
			{MP ;// Manpower (generic money)
				{StartVal 2000}
				{WinGain "1:300 4:350 6:400 8:1200 9:700 10:500 12:700 14:800"} ;// games played : MP gain 
				{LoseGain "1:200 4:250 6:300 8:350 10:400 12:450 14:500"}
				{MapRewards	;//Bonus resources on various game types (a game can only be one randomly chosen type). Types: Airfield, Ammodepot, Bonus, Factory, Research.
					{Airfield	850}
					{Ammodepot	150}
					{Bonus		425}
					{Factory	350}
					{Research	100}
				}
			}
			{SP ;// Special Points (airstrikes)
				{StartVal 5}
				{WinGain  "1:1 4:5 5:1 8:10 9:1 12:15 13:2 16:4"}
				{LoseGain "1:1 8:2 16:3 24:4"}
				{MapRewards
					{Airfield	15}
				}
			}
			{AP ;// Ammo points
				{StartVal 1000}
				{WinGain "5:500"}
				{LoseGain "5:500"}
				{MapRewards
					{Ammodepot	1200}
					{Factory	500}
				}
			}
			{RP ;// Research points
				{StartVal 8}
				{WinGain "1:1 5:2 10:3 15:4"}
				{LoseGain "1:1 15:2"}
				{MapRewards
					{Bonus		2}
					{Research	3}
					{Factory	1}
				}
			}
			{Budget
				{Start "0:5000"}
				{PointsPerSecond 0.00} ;// CP income
				{Limit 5000} ;// Max CP 
			}
		
	}
	{ResupplyCost
		{Human
			{NewItem 2 AP}
			{Weight 1 AP}
			{Mechanic 0.25 AP}
		}
		{Vehicles
			{Weight 1.0 AP}
			{Fuel 1.2 AP}
			{Resupply 0.25 AP}
			{BrokenComponent
				{body 5 % MP 40 % AP}
				{turret 5 % MP 31 % AP}
				{engine 5 % MP 32 % AP}
				{track 5 % MP 13 % AP}
				{shield 5 % MP 2 % AP}
				{other 5 % MP 2 % AP} ;// If none of the above. Required.
			}
		}
		{Support
			{Airstrikes 60 % SP}
		}
	}
}