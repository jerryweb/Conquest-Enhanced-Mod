; --- AI paradrop pairs: two C-47s per purchase, each carrying the full squad (same pattern as ger *_x2)
(define "ce_paradrop_pair_usa"
	("generic_v_conquest" t(usa %period) r(%min_stage) mr(99) cw(8) cp(1))
	{content "c47_d_para_plane ( mp/usa/%period/pilot:2 %passengers ) c47_d_para_plane ( mp/usa/%period/pilot:2 %passengers )"}
)

